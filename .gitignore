# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Embedded skill repos / third-party tool installations
.devin/skills/hallmark/
.devin/skills/*/
.claude/
.agents/skills/
skills-lock.json

# Capacitor native projects — SOURCE is committed (our Java/Kotlin lives
# here); only build artifacts and secrets stay ignored.
/ios/
/android/.gradle/
/android/build/
/android/app/build/
/android/app/release/
/android/capacitor-cordova-android-plugins/build/
/android/local.properties
/android/.idea/
/android/app/release-keystore.jks
/android/keystore.properties
*.keystore
*.jks

# Capacitor sync output (generated by cap sync)
/android/app/src/main/assets/public/
/ios/App/App/public/
/android/app/src/main/assets/next-static/

# local recite-coach engine assets (downloaded by scripts/clip-analyze.mts)
.engine/

# User-provided nasheed audio (large binary content, not code)
public/audio/nasheeds/*.mp3
public/audio/nasheeds/*.m4a
public/audio/nasheeds/*.ogg
public/audio/nasheeds/*.opus
